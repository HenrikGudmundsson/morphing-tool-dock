# Copy to .env and fill in for local dev.

ANTHROPIC_API_KEY=

# Plain postgresql:// -- rewritten to postgresql+asyncpg:// in code
# (db/pool.py, alembic/env.py), never stored pre-rewritten. Matches
# docker-compose.dev.yml's postgres service.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_backend

# Usage limits. All optional; these are the defaults (see config.py).
# MAX_QUERY_CHARS=400
# MAX_REPLY_TOKENS=300
# MAX_MODEL_REQUESTS=2
# HISTORY_TURNS=6
# LIMIT_PER_IP_PER_HOUR=20
# LIMIT_PER_SESSION_PER_DAY=30
# DAILY_TOKEN_BUDGET=500000
#
# Locally every request comes from 127.0.0.1, so you will probably want to
# raise the per-IP limit while developing.
